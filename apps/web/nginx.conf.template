# Protocole d'origine : celui annonce par Caddy, sinon le notre.
map $http_x_forwarded_proto $savoire_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Integrable ailleurs : les vues de modules (/view, code d'integration du
# partage). Le reste de l'appli ne s'affiche que dans Savoire.
map $request_uri $savoire_frame_ancestors {
    ~^/view     "*";
    default     "'self'";
}

# Politique de securite de l'appli (M3). Seuls ses propres scripts tournent,
# plus le WebAssembly (index local, OCR, LaTeX) et les plugins du store (code
# signe, verifie puis evalue depuis une adresse blob:). Styles en ligne : React.
# Reseau ouvert en https (fournisseurs d'IA, connexion, langues de l'OCR) et
# vers le poste (Ollama). Images et videos des notes : https, donnees, blob.
# Boards et plugins du store : dans /frame.html, qui a sa propre politique.
map $request_uri $savoire_csp {
    default "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss: ws://localhost:* http://localhost:* http://127.0.0.1:* http://*.localhost:*; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors $savoire_frame_ancestors";
}

server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    # DECISION: Buffers agrandis pour les JWTs et cookies larges (défaut 8k insuffisant).
    large_client_header_buffers 4 32k;
    client_header_buffer_size 4k;

    # Pieces jointes : le defaut de nginx (1 Mio) est trop juste.
    client_max_body_size 64m;

    # Proxy vers l'API — miroir du proxy Vite en dev
    # DECISION: Timeouts longs pour absorber le cold-start Azure Container Apps (scale-to-zero).
    location /api/ {
        proxy_pass ${API_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        # L'adresse du visiteur, le protocole et l'hote d'origine (limites par
        # adresse, adresses des pages publiees). Voir ForwardedHeaders dans l'API.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $savoire_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 120s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
        # DECISION: SNI requis pour TLS vers Azure Container Apps (IP interne sans certificat dédié).
        proxy_ssl_server_name on;
    }

    # Proxy SignalR WebSocket
    location /hubs/ {
        proxy_pass ${API_URL}/hubs/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $proxy_host;
        # L'adresse du visiteur, le protocole et l'hote d'origine (limites par
        # adresse, adresses des pages publiees). Voir ForwardedHeaders dans l'API.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $savoire_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_connect_timeout 120s;
        proxy_read_timeout    3600s;
        proxy_ssl_server_name on;
    }

    # SPA fallback
    # Pages publiees sur le web (/p/<nom>) : servies par l'API, en HTML.
    location /p/ {
        proxy_pass ${API_URL}/p/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        # L'adresse du visiteur, le protocole et l'hote d'origine (limites par
        # adresse, adresses des pages publiees). Voir ForwardedHeaders dans l'API.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $savoire_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_ssl_server_name on;
    }

    location / {
        add_header Content-Security-Policy $savoire_csp always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()" always;
        try_files $uri $uri/ /index.html;
    }

    # Cadre des boards et des plugins du store : sa propre politique (scripts
    # en ligne permis, aucun acces a l'appli : iframe isolee, origine opaque).
    # Le document ecrit dedans resserre encore (sa balise meta : pas de reseau
    # sans la permission network du plugin).
    location = /frame.html {
        add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; media-src data: blob:; connect-src https:; form-action 'none'; base-uri 'none'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "no-store" always;
    }

    # Polices : servies ici (aucun appel a un autre domaine), nom au contenu.
    location ~* ^/fonts/.+\.woff2$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Cache long pour les assets hashés par Vite
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
