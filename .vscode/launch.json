{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Frontend (Chrome)",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/apps/web",
            "sourceMapPathOverrides": {
                "webpack:///./~/*": "${workspaceFolder}/frontend/node_modules/*",
                "webpack:///src/*": "${workspaceFolder}/apps/web/src/*"
            },
            "preLaunchTask": "frontend:web:dev"
        },
        {
            "name": "Debug Backend (Rust)",
            "type": "lldb",
            "request": "launch",
            "cargo": { "args": ["build", "--manifest-path", "${workspaceFolder}/backend/Cargo.toml"] },
            "args": [],
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "SAVOIRE_ENVIRONMENT": "Development"
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack (Backend + Frontend)",
            "configurations": ["Debug Backend (Rust)", "Debug Frontend (Chrome)"]
        }
    ]
}

