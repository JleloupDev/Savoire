{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend:web:dev",
      "type": "shell",
      "command": "C:\\Users\\jlelo\\AppData\\Roaming\\npm\\pnpm.cmd",
      "args": ["exec", "vite"],
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "backend:api",
      "type": "process",
      "command": "dotnet",
      "args": ["run"],
      "options": {
        "cwd": "${workspaceFolder}/backend/Savoire.API"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building",
          "endsPattern": "Now listening on"
        }
      }
    }
  ]
}

