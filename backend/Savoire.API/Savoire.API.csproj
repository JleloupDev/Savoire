<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Savoire.Server</RootNamespace>
    <AssemblyName>Savoire.Server</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>44f6b2f7-dad7-49fc-baeb-f06b4daf1063</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
<ProjectReference Include="..\Savoire.Application\Savoire.Application.csproj" />
    <ProjectReference Include="..\Savoire.Domain\Savoire.Domain.csproj" />
    <ProjectReference Include="..\Savoire.Infrastructure\Savoire.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- DECISION: exclure l'obj/bin du sous-projet Api/ pour éviter les attributs assembly dupliqués -->
    <Compile Remove="Api\obj\**" />
    <Compile Remove="Api\bin\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="openapi.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
