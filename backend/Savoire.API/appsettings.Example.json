{
  "Storage": {
    "Root": "storage"
  },
  "Jwt": {
    "Secret": "CHANGE_ME_use_a_32_char_minimum_secret_key",
    "Issuer": "savoire-server",
    "Audience": "savoire-client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Admin": {
    "Email": "admin@local.dev",
    "Password": "Admin1234!",
    "DisplayName": "Admin"
  },
  "Users": [
    {
      "Id": "user1",
      "DisplayName": "User 1",
      "DefaultVaultPath": ""
    }
  ],
  "AllowedOrigins": [],
  // Pair indexeur (ADR-027, docs/Architecture/indexer-protocol.md).
  // Desactive tant que ServiceToken est vide : pas d'API interne (404),
  // routes publiques du pair en 503. En variables d'environnement :
  // Indexer__ServiceToken, Indexer__Instances__0__Name, Indexer__Instances__0__Url...
  "Indexer": {
    // Jeton partage avec le pair (SAVOIRE_INDEXER_TOKEN cote pair). Long et aleatoire.
    "ServiceToken": "",
    // Instances du pair, sur le reseau prive. Les vaults sont repartis par
    // hachage de rendez-vous : ajouter une instance ne deplace qu'environ 1/n des vaults.
    "Instances": [
      { "Name": "idx-a", "Url": "http://idx-a:7070" }
    ],
    // Delai maximal d'un appel relaye au pair (ms) ; au-dela, 503.
    "TimeoutMs": 5000,
    // Taille maximale du corps d'une requete publique (octets, 64 Kio).
    "MaxBodyBytes": 65536,
    // Taille maximale d'une reponse du pair (octets) ; au-dela, 503.
    "MaxResponseBytes": 8388608,
    // Recherche globale : instances interrogees en meme temps, au plus.
    "SearchParallelism": 4,
    // Retry-After (secondes) quand le pair est absent ou indisponible.
    "RetryAfterSeconds": 5,
    // Limitation de debit des routes publiques (seau de jetons, par minute).
    // Depassement : 429 + Retry-After.
    "RateLimit": {
      "PerUserPerMinute": 300,
      "PerVaultPerMinute": 1200
    }
  },
  "DesktopAppOrigins": [ "tauri://localhost", "http://tauri.localhost", "https://tauri.localhost" ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
