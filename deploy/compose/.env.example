# Savoire en production (docker-compose.yml). Copier en .env et remplir,
# ou laisser deploy/vps/configure.sh le faire (secrets generes).
# Generer un secret : openssl rand -base64 48 | tr -d '/+=' | cut -c1-40

# Les deux fichiers : Savoire, et son exploitation (docker-compose.ops.yml).
# Sans la seconde partie : Savoire seul, sans suivi ni copie hors machine.
COMPOSE_FILE=docker-compose.yml:docker-compose.ops.yml

# ── Adresses (deux enregistrements DNS vers cette machine) ──
SAVOIRE_DOMAIN=savoire.exemple.fr
AUTH_DOMAIN=auth.exemple.fr
# Avis de Let's Encrypt (certificats).
ACME_EMAIL=admin@exemple.fr

# ── Administrateur ──
# Le compte admin de Zitadel (console : https://AUTH_DOMAIN/ui/console,
# identifiant : cette adresse), aussi administrateur de Savoire.
ADMIN_EMAIL=admin@exemple.fr
# 8 caracteres au moins, avec chiffre, majuscule et symbole.
ADMIN_PASSWORD=

# ── Secrets (a generer, a ne jamais changer ensuite pour ZITADEL_MASTERKEY) ──
POSTGRES_PASSWORD=
SAVOIRE_DB_PASSWORD=
ZITADEL_DB_PASSWORD=
# Exactement 32 caracteres. Chiffre les secrets de Zitadel : le perdre, c'est
# perdre l'acces a ses donnees.
ZITADEL_MASTERKEY=
# 32 caracteres au moins.
LOGIN_COOKIE_SECRET=
# Liens de partage et vues integrees (signes par Savoire), 32 caracteres au moins.
JWT_SECRET=

# ── Courriels (obligatoire : verification de l'adresse, mot de passe oublie) ──
# Brevo (gratuit jusqu'a 300 courriels par jour) : Brevo > SMTP & API > SMTP.
# Identifiant : l'« Identifiant SMTP » (xxxx@smtp-brevo.com) ; mot de passe :
# une « cle SMTP ». Port 465 : TLS des la connexion.
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=465
# Hote:port pour Zitadel et Alertmanager (SMTP_SERVER:SMTP_PORT).
SMTP_HOST=smtp-relay.brevo.com:465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
# Une adresse du domaine verifie chez Brevo (SPF, DKIM, DMARC).
SMTP_FROM=noreply@exemple.fr
SMTP_FROM_NAME=Savoire

# ── Versions ──
# Images publiees par la CI : ghcr.io/jleloupdev/savoire-{api,web,indexer}.
SAVOIRE_REGISTRY=ghcr.io/jleloupdev
# « latest » (branche master), une version (v1.2.0) ou un commit (sha-abc1234).
SAVOIRE_VERSION=latest
ZITADEL_VERSION=v4.16.0
PORTAINER_VERSION=2.45.3

# ── Divers ──
# Langue des pages de connexion et des courriels.
DEFAULT_LANGUAGE=fr
# Sauvegardes : dossier de la machine, heure (UTC), duree de conservation.
BACKUP_DIR=./backups
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14
# Portainer (administration des conteneurs), sur 127.0.0.1 seulement.
PORTAINER_PORT=9443

# ── Exploitation (docker-compose.ops.yml) ──
# Ou partent les alertes (site arrete, disque plein, sauvegarde manquee...).
ALERT_EMAIL=admin@exemple.fr
# Tableaux de bord (Grafana, identifiant « admin ») et suivi des erreurs
# (GlitchTip, identifiant ADMIN_EMAIL), sur 127.0.0.1 : tunnel SSH.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
GLITCHTIP_ADMIN_PASSWORD=
GLITCHTIP_PORT=8100
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
PROMETHEUS_PORT=9090
METRICS_RETENTION=30d
METRICS_DIR=./metrics
ERROR_ENVIRONMENT=production

# ── Copie hors de la machine (restic, chiffree) ──
# Un stockage S3 en Europe, par exemple :
#   Scaleway : s3:https://s3.fr-par.scw.cloud/<bucket>/savoire
#   OVH      : s3:https://s3.gra.io.cloud.ovh.net/<bucket>/savoire
#   Hetzner  : s3:https://fsn1.your-objectstorage.com/<bucket>/savoire
RESTIC_REPOSITORY=
RESTIC_S3_ACCESS_KEY=
RESTIC_S3_SECRET_KEY=
RESTIC_S3_REGION=
# Chiffre la copie. LE PERDRE, C'EST PERDRE LA COPIE : le garder ailleurs que
# sur cette machine (gestionnaire de mots de passe).
RESTIC_PASSWORD=
