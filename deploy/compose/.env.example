# Savoire en production (docker-compose.yml). Copier en .env et remplir.
# Generer un secret : openssl rand -base64 48 | tr -d '/+=' | cut -c1-40

# ── Adresses (deux enregistrements DNS vers cette machine) ──
SAVOIRE_DOMAIN=savoire.exemple.fr
AUTH_DOMAIN=auth.exemple.fr
# Avis de Let's Encrypt (certificats).
ACME_EMAIL=admin@exemple.fr

# ── Administrateur ──
# Le compte admin de Zitadel (console : https://AUTH_DOMAIN/ui/console,
# identifiant : cette adresse), aussi administrateur de Savoire.
ADMIN_EMAIL=admin@exemple.fr
# 8 caracteres au moins, avec chiffre, majuscule et symbole.
ADMIN_PASSWORD=

# ── Secrets (a generer, a ne jamais changer ensuite pour ZITADEL_MASTERKEY) ──
POSTGRES_PASSWORD=
SAVOIRE_DB_PASSWORD=
ZITADEL_DB_PASSWORD=
# Exactement 32 caracteres. Chiffre les secrets de Zitadel : le perdre, c'est
# perdre l'acces a ses donnees.
ZITADEL_MASTERKEY=
# 32 caracteres au moins.
LOGIN_COOKIE_SECRET=
# Liens de partage et vues integrees (signes par Savoire), 32 caracteres au moins.
JWT_SECRET=

# ── Courriels (obligatoire : verification de l'adresse, mot de passe oublie) ──
# Un service d'envoi (Brevo, Mailjet, Scaleway...) : hote:port.
SMTP_HOST=smtp.exemple.fr:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=noreply@exemple.fr
SMTP_FROM_NAME=Savoire

# ── Versions ──
# Images publiees par la CI : ghcr.io/jleloupdev/savoire-{api,web,indexer}.
SAVOIRE_REGISTRY=ghcr.io/jleloupdev
# « latest » (branche master), une version (v1.2.0) ou un commit (sha-abc1234).
SAVOIRE_VERSION=latest
ZITADEL_VERSION=v4.16.0
PORTAINER_VERSION=2.45.3

# ── Divers ──
# Langue des pages de connexion et des courriels.
DEFAULT_LANGUAGE=fr
# Sauvegardes : dossier de la machine, heure (UTC), duree de conservation.
BACKUP_DIR=./backups
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14
# Portainer (administration des conteneurs), sur 127.0.0.1 seulement.
PORTAINER_PORT=9443
