diff --git a/apps/login/src/lib/server/savoire.ts b/apps/login/src/lib/server/savoire.ts
new file mode 100644
index 0000000..2e79b94
--- /dev/null
+++ b/apps/login/src/lib/server/savoire.ts
@@ -0,0 +1,193 @@
+"use server";
+
+// Savoire : connexion sans mot de passe.
+//
+// Trois facons d'entrer : un fournisseur (Google, Microsoft, une entreprise),
+// une passkey, ou un lien recu par mail. Le lien ouvre une page qui montre un
+// code ; ce code se tape dans la fenetre ou la connexion a ete demandee. Un
+// lien ouvert ailleurs ne connecte donc personne.
+//
+// Chez Zitadel, le code par mail (OTP_EMAIL) est d'ordinaire un second
+// facteur. Ici il sert de premiere methode, pour les comptes de
+// l'organisation par defaut. Les autres organisations (les entreprises)
+// gardent les regles de Zitadel.
+
+import { create } from "@zitadel/client";
+import { RequestChallengesSchema } from "@zitadel/proto/zitadel/session/v2/challenge_pb";
+import { ChecksSchema } from "@zitadel/proto/zitadel/session/v2/session_service_pb";
+import { AuthenticationMethodType } from "@zitadel/proto/zitadel/user/v2/user_service_pb";
+import { getTranslations } from "next-intl/server";
+import { headers } from "next/headers";
+import { completeFlowOrGetUrl } from "../client";
+import { getSessionCookieById, getSessionCookieByLoginName } from "../cookies";
+import { createLogger } from "../logger";
+import { getServiceConfig } from "../service-url";
+import {
+  addOTPEmail,
+  getDefaultOrg,
+  getLoginSettings,
+  getSession,
+  getUserByID,
+  listAuthenticationMethodTypes,
+} from "../zitadel";
+import { trySendVerification } from "./verify";
+import { updateOrCreateSession } from "./session";
+
+const logger = createLogger("savoire");
+
+/** Le compte appartient-il a l'organisation par defaut (pas a une entreprise) ? */
+export async function isDefaultOrgUser(organizationId?: string): Promise<boolean> {
+  if (!organizationId) return false;
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+  const org = await getDefaultOrg({ serviceConfig });
+  return !!org && org.id === organizationId;
+}
+
+/** Le code par mail ne marche que si la methode est inscrite sur le compte. */
+async function ensureOtpEmail(userId: string) {
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+  const methods = await listAuthenticationMethodTypes({ serviceConfig, userId });
+  if (methods.authMethodTypes?.includes(AuthenticationMethodType.OTP_EMAIL)) return;
+  await addOTPEmail({ serviceConfig, userId }).catch((error) => {
+    // 6 : deja inscrite (deux demandes en meme temps).
+    if (error?.code !== 6) throw error;
+  });
+}
+
+type EmailLoginCommand = {
+  userId: string;
+  loginName: string;
+  requestId?: string;
+  organization?: string;
+};
+
+/**
+ * Envoie le lien de connexion. Une adresse pas encore verifiee l'est d'abord :
+ * le code de verification connecte aussi (voir signInWithProvenEmail).
+ */
+export async function startEmailLogin(command: EmailLoginCommand): Promise<{ redirect: string } | { error: string }> {
+  const t = await getTranslations("savoire");
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+
+  const userResponse = await getUserByID({ serviceConfig, userId: command.userId });
+  const human = userResponse?.user?.type.case === "human" ? userResponse.user.type.value : undefined;
+  if (!human?.email?.email) {
+    return { error: t("errors.noEmail") };
+  }
+
+  const params = new URLSearchParams({ loginName: command.loginName });
+  if (command.requestId) params.set("requestId", command.requestId);
+  if (command.organization) params.set("organization", command.organization);
+
+  if (!human.email.isVerified) {
+    const codeSent = await trySendVerification({ userId: command.userId, isInvite: false, requestId: command.requestId });
+    params.set("userId", command.userId);
+    if (codeSent) params.set("codeSent", "true");
+    return { redirect: "/verify?" + params };
+  }
+
+  try {
+    await ensureOtpEmail(command.userId);
+  } catch (error) {
+    logger.error("Could not enable email login", { error });
+    return { error: t("errors.couldNotSendLink") };
+  }
+
+  // La page /otp/email demande l'envoi du mail en arrivant.
+  return { redirect: "/otp/email?" + params };
+}
+
+/** Depuis l'ecran de passkey : « Recevoir un lien par mail » a la place. */
+export async function startEmailLoginForLoginName({
+  loginName,
+  requestId,
+  organization,
+}: {
+  loginName: string;
+  requestId?: string;
+  organization?: string;
+}): Promise<{ redirect: string } | { error: string }> {
+  const t = await getTranslations("error");
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+
+  const cookie = await getSessionCookieByLoginName({ loginName, organization });
+  if (!cookie) {
+    return { error: t("couldNotContinueSession") };
+  }
+  const response = await getSession({ serviceConfig, sessionId: cookie.id, sessionToken: cookie.token });
+  const user = response?.session?.factors?.user;
+  if (!user?.id || !(await isDefaultOrgUser(user.organizationId))) {
+    return { error: t("couldNotContinueSession") };
+  }
+  return startEmailLogin({ userId: user.id, loginName: user.loginName, requestId, organization });
+}
+
+/**
+ * Appele juste apres une verification d'adresse reussie, dans ce navigateur :
+ * la personne vient de prouver qu'elle lit ce courrier, comme avec le lien de
