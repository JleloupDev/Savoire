diff --git a/apps/login/src/components/savoire-add-passkey.tsx b/apps/login/src/components/savoire-add-passkey.tsx
new file mode 100644
index 0000000..634f061
--- /dev/null
+++ b/apps/login/src/components/savoire-add-passkey.tsx
@@ -0,0 +1,101 @@
+"use client";
+
+// Savoire : /passkey/add. Avec une session valide, la cle s'ajoute tout de
+// suite ; sans, on envoie d'abord le lien par mail et on attend son code.
+import { checkPasskeyAddCode, startPasskeyAddByEmail } from "@/lib/server/savoire";
+import { useTranslations } from "next-intl";
+import { useState } from "react";
+import { Alert, AlertType } from "./alert";
+import { Button, ButtonVariants } from "./button";
+import { TextInput } from "./input";
+import { RegisterPasskey } from "./register-passkey";
+import { Spinner } from "./spinner";
+import { Translated } from "./translated";
+
+type Props = { loginName: string; sessionId?: string };
+
+type Step = { kind: "email" } | { kind: "code"; sessionId: string } | { kind: "register"; sessionId: string } | { kind: "done" };
+
+export function AddPasskey({ loginName, sessionId }: Props) {
+  const [step, setStep] = useState<Step>(sessionId ? { kind: "register", sessionId } : { kind: "email" });
+  const [code, setCode] = useState("");
+  const [error, setError] = useState("");
+  const [loading, setLoading] = useState(false);
+  const t = useTranslations("savoire");
+
+  async function sendLink() {
+    setLoading(true);
+    setError("");
+    const res = await startPasskeyAddByEmail({ loginName }).catch(() => undefined);
+    setLoading(false);
+    if (!res) return setError(t("passkeyAdd.errors.generic"));
+    if ("error" in res) return setError(res.error);
+    setStep({ kind: "code", sessionId: res.sessionId });
+  }
+
+  async function checkCode(current: string) {
+    setLoading(true);
+    setError("");
+    const res = await checkPasskeyAddCode({ sessionId: current, code }).catch(() => undefined);
+    setLoading(false);
+    if (!res || "error" in res) return setError(res && "error" in res ? res.error : t("passkeyAdd.errors.generic"));
+    setStep({ kind: "register", sessionId: current });
+  }
+
+  if (step.kind === "done") {
+    return (
+      <div data-testid="passkey-added">
+        <Alert type={AlertType.INFO}>
+          <Translated i18nKey="passkeyAdd.done" namespace="savoire" />
+        </Alert>
+      </div>
+    );
+  }
+
+  if (step.kind === "register") {
+    return <RegisterPasskey sessionId={step.sessionId} isPrompt={false} loginName={loginName} onRegistered={() => setStep({ kind: "done" })} />;
+  }
+
+  return (
+    <form
+      className="w-full"
+      onSubmit={(e) => {
+        e.preventDefault();
+        if (step.kind === "email") void sendLink();
+        else void checkCode(step.sessionId);
+      }}
+    >
+      <p className="ztdl-p mb-4">
+        <Translated i18nKey={step.kind === "email" ? "passkeyAdd.confirmFirst" : "passkeyAdd.codeSent"} namespace="savoire" />
+      </p>
+      {step.kind === "code" && (
+        <TextInput
+          type="text"
+          autoFocus
+          value={code}
+          onChange={(e) => setCode(e.target.value)}
+          label={t("passkeyAdd.codeLabel")}
+          autoComplete="one-time-code"
+          data-testid="code-text-input"
+        />
+      )}
+      {error && (
+        <div className="py-4" data-testid="error">
+          <Alert>{error}</Alert>
+        </div>
+      )}
+      <div className="mt-8 flex w-full flex-row items-center">
+        {step.kind === "code" && (
+          <Button type="button" variant={ButtonVariants.Secondary} disabled={loading} onClick={() => void sendLink()}>
+            <Translated i18nKey="passkeyAdd.resend" namespace="savoire" />
+          </Button>
+        )}
+        <span className="flex-grow"></span>
+        <Button type="submit" variant={ButtonVariants.Primary} disabled={loading || (step.kind === "code" && !code.trim())} data-testid="submit-button">
+          {loading && <Spinner className="mr-2 h-5 w-5" />}
+          <Translated i18nKey={step.kind === "email" ? "passkeyAdd.sendLink" : "passkeyAdd.checkCode"} namespace="savoire" />
+        </Button>
+      </div>
+    </form>
+  );
+}
