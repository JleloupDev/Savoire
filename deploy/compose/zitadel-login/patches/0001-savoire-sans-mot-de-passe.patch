diff --git a/apps/login/src/lib/server/savoire.ts b/apps/login/src/lib/server/savoire.ts
new file mode 100644
index 0000000..39d4319
--- /dev/null
+++ b/apps/login/src/lib/server/savoire.ts
@@ -0,0 +1,321 @@
+"use server";
+
+// Savoire : connexion sans mot de passe.
+//
+// Trois facons d'entrer : un fournisseur (Google, Microsoft, une entreprise),
+// une passkey, ou un lien recu par mail. Le lien ouvre une page qui montre un
+// code ; ce code se tape dans la fenetre ou la connexion a ete demandee. Un
+// lien ouvert ailleurs ne connecte donc personne.
+//
+// Chez Zitadel, le code par mail (OTP_EMAIL) est d'ordinaire un second
+// facteur. Ici il sert de premiere methode, pour les comptes de
+// l'organisation par defaut. Les autres organisations (les entreprises)
+// gardent les regles de Zitadel.
+
+import { create } from "@zitadel/client";
+import { RequestChallengesSchema } from "@zitadel/proto/zitadel/session/v2/challenge_pb";
+import { ChecksSchema } from "@zitadel/proto/zitadel/session/v2/session_service_pb";
+import { PasskeysType } from "@zitadel/proto/zitadel/settings/v2/login_settings_pb";
+import { AuthenticationMethodType } from "@zitadel/proto/zitadel/user/v2/user_service_pb";
+import { getTranslations } from "next-intl/server";
+import { cookies, headers } from "next/headers";
+import { completeFlowOrGetUrl } from "../client";
+import { getSessionCookieById, getSessionCookieByLoginName } from "../cookies";
+import { createLogger } from "../logger";
+import { getServiceConfig } from "../service-url";
+import {
+  addOTPEmail,
+  getDefaultOrg,
+  getLoginSettings,
+  getSession,
+  getUserByID,
+  listAuthenticationMethodTypes,
+} from "../zitadel";
+import { findUserForPasskeyAdd } from "../savoire-passkey";
+import { createSessionAndUpdateCookie } from "./cookie";
+import { getPublicHostWithProtocol } from "./host";
+import { trySendVerification } from "./verify";
+import { updateOrCreateSession } from "./session";
+
+const logger = createLogger("savoire");
+
+/** Le compte appartient-il a l'organisation par defaut (pas a une entreprise) ? */
+export async function isDefaultOrgUser(organizationId?: string): Promise<boolean> {
+  if (!organizationId) return false;
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+  const org = await getDefaultOrg({ serviceConfig });
+  return !!org && org.id === organizationId;
+}
+
+/** Le code par mail ne marche que si la methode est inscrite sur le compte. */
+async function ensureOtpEmail(userId: string) {
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+  const methods = await listAuthenticationMethodTypes({ serviceConfig, userId });
+  if (methods.authMethodTypes?.includes(AuthenticationMethodType.OTP_EMAIL)) return;
+  await addOTPEmail({ serviceConfig, userId }).catch((error) => {
+    // 6 : deja inscrite (deux demandes en meme temps).
+    if (error?.code !== 6) throw error;
+  });
+}
+
+type EmailLoginCommand = {
+  userId: string;
+  loginName: string;
+  requestId?: string;
+  organization?: string;
+};
+
+/**
+ * Envoie le lien de connexion. Une adresse pas encore verifiee l'est d'abord :
+ * le code de verification connecte aussi (voir signInWithProvenEmail).
+ */
+export async function startEmailLogin(command: EmailLoginCommand): Promise<{ redirect: string } | { error: string }> {
+  const t = await getTranslations("savoire");
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+
+  const userResponse = await getUserByID({ serviceConfig, userId: command.userId });
+  const human = userResponse?.user?.type.case === "human" ? userResponse.user.type.value : undefined;
+  if (!human?.email?.email) {
+    return { error: t("errors.noEmail") };
+  }
+
+  const params = new URLSearchParams({ loginName: command.loginName });
+  if (command.requestId) params.set("requestId", command.requestId);
+  if (command.organization) params.set("organization", command.organization);
+
+  if (!human.email.isVerified) {
+    const codeSent = await trySendVerification({ userId: command.userId, isInvite: false, requestId: command.requestId });
+    params.set("userId", command.userId);
+    if (codeSent) params.set("codeSent", "true");
+    return { redirect: "/verify?" + params };
+  }
+
+  try {
+    await ensureOtpEmail(command.userId);
+  } catch (error) {
+    logger.error("Could not enable email login", { error });
+    return { error: t("errors.couldNotSendLink") };
+  }
+
+  // La page /otp/email demande l'envoi du mail en arrivant.
+  return { redirect: "/otp/email?" + params };
+}
+
+/** Depuis l'ecran de passkey : « Recevoir un lien par mail » a la place. */
+export async function startEmailLoginForLoginName({
+  loginName,
+  requestId,
+  organization,
+}: {
+  loginName: string;
+  requestId?: string;
+  organization?: string;
+}): Promise<{ redirect: string } | { error: string }> {
+  const t = await getTranslations("error");
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+
+  const cookie = await getSessionCookieByLoginName({ loginName, organization });
+  if (!cookie) {
+    return { error: t("couldNotContinueSession") };
+  }
+  const response = await getSession({ serviceConfig, sessionId: cookie.id, sessionToken: cookie.token });
+  const user = response?.session?.factors?.user;
+  if (!user?.id || !(await isDefaultOrgUser(user.organizationId))) {
+    return { error: t("couldNotContinueSession") };
+  }
+  return startEmailLogin({ userId: user.id, loginName: user.loginName, requestId, organization });
+}
+
+/**
+ * Appele juste apres une verification d'adresse reussie, dans ce navigateur :
+ * la personne vient de prouver qu'elle lit ce courrier, comme avec le lien de
+ * connexion. La session recoit donc le facteur « code par mail », sans
+ * second envoi.
+ */
+export async function signInWithProvenEmail({ sessionId, userId }: { sessionId: string; userId: string }) {
+  await ensureOtpEmail(userId);
+
+  const challenge = await updateOrCreateSession({
+    sessionId,
+    challenges: create(RequestChallengesSchema, {
+      otpEmail: { deliveryType: { case: "returnCode", value: {} } },
+    }),
+  });
+  if (!challenge || "error" in challenge) {
+    throw new Error("Could not request email challenge");
+  }
+  const code = challenge.challenges?.otpEmail;
+  if (!code) {
+    throw new Error("No email code returned");
+  }
+
+  const checked = await updateOrCreateSession({
+    sessionId,
+    checks: create(ChecksSchema, { otpEmail: { code } }),
+  });
+  if (!checked || "error" in checked) {
+    throw new Error("Could not check email code");
+  }
+  return checked;
+}
+
+/** Apres la proposition de passkey (acceptee ou non) : terminer la connexion. */
+export async function continueWithSessionId({
+  sessionId,
+  requestId,
+  organization,
+}: {
+  sessionId: string;
+  requestId?: string;
+  organization?: string;
+}) {
+  const t = await getTranslations("error");
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+
+  const cookie = await getSessionCookieById({ sessionId, organization });
+  if (!cookie) {
+    return { error: t("couldNotContinueSession") };
+  }
+  const response = await getSession({ serviceConfig, sessionId: cookie.id, sessionToken: cookie.token });
+  const session = response?.session;
+  if (!session?.factors?.user) {
+    return { error: t("couldNotContinueSession") };
+  }
+
+  const loginSettings = await getLoginSettings({ serviceConfig, organization: session.factors.user.organizationId });
+  return completeFlowOrGetUrl(
+    requestId
+      ? { sessionId: session.id, requestId, organization: session.factors.user.organizationId }
+      : { loginName: session.factors.user.loginName, organization: session.factors.user.organizationId },
+    loginSettings?.defaultRedirectUri,
+  );
+}
+
+// --- Clé d'accès proposée après le lien par mail -------------------------
+
+/** « Ne plus demander » : ce navigateur ne propose plus la clé d'accès. */
+const NO_PASSKEY_PROMPT_COOKIE = "savoire_no_passkey_prompt";
+
+/**
+ * Juste après une connexion par le lien du mail : faut-il proposer une clé
+ * d'accès ? Oui pour un compte de l'organisation par défaut qui n'en a pas,
+ * si les clés sont permises et si ce navigateur n'a pas dit « Ne plus
+ * demander ». Rend l'adresse de la proposition, ou null pour continuer.
+ */
+export async function passkeyPromptAfterEmailLogin({
+  sessionId,
+  requestId,
+  organization,
+}: {
+  sessionId: string;
+  requestId?: string;
+  organization?: string;
+}): Promise<{ redirect: string } | null> {
+  try {
+    const cookiesList = await cookies();
+    if (cookiesList.get(NO_PASSKEY_PROMPT_COOKIE)?.value === "1") return null;
+
+    const _headers = await headers();
+    const { serviceConfig } = getServiceConfig(_headers);
+    const cookie = await getSessionCookieById({ sessionId, organization });
+    if (!cookie) return null;
+    const response = await getSession({ serviceConfig, sessionId: cookie.id, sessionToken: cookie.token });
+    const user = response?.session?.factors?.user;
+    if (!user?.id || !(await isDefaultOrgUser(user.organizationId))) return null;
+
+    const methods = await listAuthenticationMethodTypes({ serviceConfig, userId: user.id });
+    if (methods.authMethodTypes?.includes(AuthenticationMethodType.PASSKEY)) return null;
+    const loginSettings = await getLoginSettings({ serviceConfig, organization: user.organizationId });
+    if (loginSettings?.passkeysType !== PasskeysType.ALLOWED) return null;
+
+    const params = new URLSearchParams({ loginName: user.loginName, prompt: "true", after: "email" });
+    if (organization) params.set("organization", organization);
+    if (requestId) params.set("requestId", requestId);
+    return { redirect: "/passkey/set?" + params };
+  } catch (error) {
+    // La proposition est un plus : en cas d'erreur, la connexion continue.
+    logger.error("Could not check passkey prompt", { error });
+    return null;
+  }
+}
+
+/** « Ne plus demander », pour un an, dans ce navigateur. */
+export async function stopPasskeyPrompt(): Promise<void> {
+  const cookiesList = await cookies();
+  cookiesList.set({
+    name: NO_PASSKEY_PROMPT_COOKIE,
+    value: "1",
+    httpOnly: true,
+    path: "/",
+    sameSite: "lax",
+    secure: process.env.NODE_ENV === "production",
+    maxAge: 365 * 24 * 60 * 60,
+  });
+}
+
+// --- Ajouter une clé d'accès depuis Savoire (/passkey/add) ----------------
+
+/**
+ * Pas de session valide dans ce navigateur : on la refait par le lien du
+ * mail (organisation par défaut seulement), puis la clé s'ajoute.
+ * Rend la nouvelle session, dont le code reste à vérifier.
+ */
+export async function startPasskeyAddByEmail({
+  loginName,
+}: {
+  loginName: string;
+}): Promise<{ sessionId: string } | { error: string }> {
+  const t = await getTranslations("savoire");
+  const user = await findUserForPasskeyAdd(loginName);
+  if (!user) return { error: t("passkeyAdd.errors.unknownAccount") };
+  if (!(await isDefaultOrgUser(user.organizationId))) return { error: t("passkeyAdd.errors.organization") };
+
+  try {
+    await ensureOtpEmail(user.userId);
+    const created = await createSessionAndUpdateCookie({
+      checks: create(ChecksSchema, { user: { search: { case: "userId", value: user.userId } } }),
+      requestId: undefined,
+    });
+    const _headers = await headers();
+    const basePath = process.env.NEXT_PUBLIC_BASE_PATH ?? "";
+    const challenge = await updateOrCreateSession({
+      sessionId: created.session.id,
+      challenges: create(RequestChallengesSchema, {
+        otpEmail: {
+          deliveryType: {
+            case: "sendCode",
+            // Comme pour la connexion : le lien montre le code, il ne connecte pas.
+            value: { urlTemplate: `${getPublicHostWithProtocol(_headers)}${basePath}/code?code={{.Code}}` },
+          },
+        },
+      }),
+    });
+    if (!challenge || "error" in challenge) throw new Error("Could not send email code");
+    return { sessionId: created.session.id };
+  } catch (error) {
+    logger.error("Could not start passkey add by email", { error });
+    return { error: t("errors.couldNotSendLink") };
+  }
+}
+
+/** Le code du mail, tapé sur /passkey/add : la session devient valide. */
+export async function checkPasskeyAddCode({
+  sessionId,
+  code,
+}: {
+  sessionId: string;
+  code: string;
+}): Promise<{ ok: true } | { error: string }> {
+  const t = await getTranslations("savoire");
+  const checked = await updateOrCreateSession({
+    sessionId,
+    checks: create(ChecksSchema, { otpEmail: { code: code.trim() } }),
+  }).catch(() => undefined);
+  if (!checked || "error" in checked) return { error: t("passkeyAdd.errors.wrongCode") };
+  return { ok: true };
+}
