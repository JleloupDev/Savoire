diff --git a/apps/login/src/app/(login)/passkey/add/page.tsx b/apps/login/src/app/(login)/passkey/add/page.tsx
new file mode 100644
index 0000000..edd6766
--- /dev/null
+++ b/apps/login/src/app/(login)/passkey/add/page.tsx
@@ -0,0 +1,85 @@
+// Savoire : ajouter une cle d'acces depuis l'appli (Parametres -> Compte).
+// L'appli ouvre cette page dans un onglet, avec l'adresse du compte. Une
+// session valide dans ce navigateur suffit ; sinon, le lien par mail la
+// refait (organisation par defaut seulement). Rien ne redirige ensuite :
+// la personne ferme l'onglet.
+import { AddPasskey } from "@/components/savoire-add-passkey";
+import { Alert } from "@/components/alert";
+import { DynamicTheme } from "@/components/dynamic-theme";
+import { Translated } from "@/components/translated";
+import { UserAvatar } from "@/components/user-avatar";
+import { findUserForPasskeyAdd } from "@/lib/savoire-passkey";
+import { getServiceConfig } from "@/lib/service-url";
+import { isSessionValid, loadMostRecentSession } from "@/lib/session";
+import { getBrandingSettings, getLoginSettings, listAuthenticationMethodTypes } from "@/lib/zitadel";
+import { PasskeysType } from "@zitadel/proto/zitadel/settings/v2/login_settings_pb";
+import { AuthenticationMethodType } from "@zitadel/proto/zitadel/user/v2/user_service_pb";
+import { Session } from "@zitadel/proto/zitadel/session/v2/session_pb";
+import { Metadata } from "next";
+import { getTranslations } from "next-intl/server";
+import { headers } from "next/headers";
+
+export async function generateMetadata(): Promise<Metadata> {
+  const t = await getTranslations("savoire");
+  return { title: t("passkeyAdd.title") };
+}
+
+export default async function Page(props: { searchParams: Promise<Record<string | number | symbol, string | undefined>> }) {
+  const searchParams = await props.searchParams;
+  const loginName = (searchParams.loginName ?? "").trim();
+
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+
+  const user = loginName ? await findUserForPasskeyAdd(loginName) : undefined;
+  const organization = user?.organizationId;
+  const branding = await getBrandingSettings({ serviceConfig, organization });
+  const loginSettings = user ? await getLoginSettings({ serviceConfig, organization }) : undefined;
+  const allowed = loginSettings?.passkeysType === PasskeysType.ALLOWED;
+
+  // La session de ce navigateur pour ce compte, si elle vaut encore.
+  let session: Session | undefined;
+  if (user && allowed) {
+    for (const name of [user.loginName, loginName]) {
+      const found = await loadMostRecentSession({ serviceConfig, sessionParams: { loginName: name } }).catch(() => undefined);
+      if (found?.factors?.user?.id === user.userId && (await isSessionValid({ serviceConfig, session: found }))) {
+        session = found;
+        break;
+      }
+    }
+  }
+
+  const hasPasskey = user
+    ? (await listAuthenticationMethodTypes({ serviceConfig, userId: user.userId }).catch(() => undefined))?.authMethodTypes?.includes(
+        AuthenticationMethodType.PASSKEY,
+      ) ?? false
+    : false;
+
+  return (
+    <DynamicTheme branding={branding}>
+      <div className="flex flex-col space-y-4">
+        <h1>
+          <Translated i18nKey="passkeyAdd.title" namespace="savoire" />
+        </h1>
+        <p className="ztdl-p mb-6 block">
+          <Translated i18nKey={hasPasskey ? "passkeyAdd.descriptionMore" : "passkeyAdd.description"} namespace="savoire" />
+        </p>
+        {user && <UserAvatar loginName={user.loginName} displayName={session?.factors?.user?.displayName} showDropdown={false} />}
+      </div>
+
+      <div className="w-full">
+        {!user ? (
+          <Alert>
+            <Translated i18nKey="passkeyAdd.errors.unknownAccount" namespace="savoire" />
+          </Alert>
+        ) : !allowed ? (
+          <Alert>
+            <Translated i18nKey="passkeyAdd.errors.notAllowed" namespace="savoire" />
+          </Alert>
+        ) : (
+          <AddPasskey loginName={user.loginName} sessionId={session?.id} />
+        )}
+      </div>
+    </DynamicTheme>
+  );
+}
