+  const challenge = await updateOrCreateSession({
+    sessionId,
+    challenges: create(RequestChallengesSchema, {
+      otpEmail: { deliveryType: { case: "returnCode", value: {} } },
+    }),
+  });
+  if (!challenge || "error" in challenge) {
+    throw new Error("Could not request email challenge");
+  }
+  const code = challenge.challenges?.otpEmail;
+  if (!code) {
+    throw new Error("No email code returned");
+  }
+
+  const checked = await updateOrCreateSession({
+    sessionId,
+    checks: create(ChecksSchema, { otpEmail: { code } }),
+  });
+  if (!checked || "error" in checked) {
+    throw new Error("Could not check email code");
+  }
+  return checked;
+}
+
+/** Apres la proposition de passkey (acceptee ou non) : terminer la connexion. */
+export async function continueWithSessionId({
+  sessionId,
+  requestId,
+  organization,
+}: {
+  sessionId: string;
+  requestId?: string;
+  organization?: string;
+}) {
+  const t = await getTranslations("error");
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+
+  const cookie = await getSessionCookieById({ sessionId, organization });
+  if (!cookie) {
+    return { error: t("couldNotContinueSession") };
+  }
+  const response = await getSession({ serviceConfig, sessionId: cookie.id, sessionToken: cookie.token });
+  const session = response?.session;
+  if (!session?.factors?.user) {
+    return { error: t("couldNotContinueSession") };
+  }
+
+  const loginSettings = await getLoginSettings({ serviceConfig, organization: session.factors.user.organizationId });
+  return completeFlowOrGetUrl(
+    requestId
+      ? { sessionId: session.id, requestId, organization: session.factors.user.organizationId }
+      : { loginName: session.factors.user.loginName, organization: session.factors.user.organizationId },
+    loginSettings?.defaultRedirectUri,
+  );
+}
