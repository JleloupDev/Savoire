+// Savoire : chercher le compte pour /passkey/add. Pas une action serveur
+// ("use server") : appelee seulement depuis le serveur, elle ne doit pas
+// devenir un point d'entree qui revele les comptes.
+import { headers } from "next/headers";
+import { getServiceConfig } from "./service-url";
+import { getLoginSettings, searchUsers } from "./zitadel";
+
+/** Le compte designe par son adresse, s'il est unique. */
+export async function findUserForPasskeyAdd(
+  loginName: string,
+): Promise<{ userId: string; loginName: string; organizationId: string } | undefined> {
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+  const loginSettings = await getLoginSettings({ serviceConfig });
+  if (!loginSettings) return undefined;
+  const found = await searchUsers({ serviceConfig, searchValue: loginName, loginSettings }).catch(() => undefined);
+  const users = found && "result" in found ? (found.result ?? []) : [];
+  if (users.length !== 1) return undefined;
+  const user = users[0];
+  if (!user.userId || !user.details?.resourceOwner) return undefined;
+  return {
+    userId: user.userId,
+    loginName: user.preferredLoginName || loginName,
+    organizationId: user.details.resourceOwner,
+  };
+}
